{
  "name": "hexadih",
  "version": "1.0.0",
  "description": "On-device visual perception for light-weight browser agents (SIH26171)",
  "private": true,
  "scripts": {
    "models:fetch": "node scripts/fetch-models.mjs",
    "dev:extension": "pnpm --filter @hexadih/extension dev",
    "dev:server": "pnpm --filter @hexadih/server dev",
    "dev:dashboard": "pnpm --filter @hexadih/dashboard dev",
    "dev:web": "pnpm --filter @hexadih/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run compile",
    "test": "turbo run test",
    "check": "node scripts/check-invariants.mjs",
    "verify": "pnpm check && pnpm typecheck && pnpm test"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  }
}
